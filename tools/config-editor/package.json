{
  "name": "config-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "actions": "bun run src/cli.ts actions",
    "actions:generate": "bun run src/cli.ts actions --output generated/action-catalog.json",
    "compile:linux-arm64": "bun run scripts/compile.ts bun-linux-arm64",
    "compile:linux-x64": "bun run scripts/compile.ts bun-linux-x64",
    "compile:local": "bun run scripts/compile.ts",
    "compile:macos-arm64": "bun run scripts/compile.ts bun-darwin-arm64",
    "compile:macos-x64": "bun run scripts/compile.ts bun-darwin-x64",
    "compile:windows-x64": "bun run scripts/compile.ts bun-windows-x64",
    "start": "bun run src/start.ts",
    "surface-coverage": "bun run src/cli.ts surface-coverage",
    "test": "bun test",
    "validate": "bun run src/cli.ts validate"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3"
  }
}
