get_filename_component(SETTINGS_SCHEMA_FILE "${CMAKE_CURRENT_LIST_DIR}/../Scripts/settings_schema.conf" ABSOLUTE)
if(NOT EXISTS "${SETTINGS_SCHEMA_FILE}")
  message(FATAL_ERROR "Settings schema does not exist: ${SETTINGS_SCHEMA_FILE}")
endif()
set(SETTINGS_SCHEMA_ALLOWED_PROPERTIES Setting Type Default Values Scopes Category Min Max Unit GreaterThan)
set(SETTINGS_SCHEMA_SEEN_SETTINGS)
set(SETTINGS_SCHEMA_RELATIONSHIPS)
set(SETTINGS_SCHEMA_ROWS "")
set(SETTINGS_SCHEMA_VERSION "")
set(SETTINGS_SCHEMA_SAW_SETTING FALSE)

file(STRINGS "${SETTINGS_SCHEMA_FILE}" SETTINGS_SCHEMA_LINES)
set(SETTINGS_SCHEMA_LINE_NUMBER 0)
foreach(SETTINGS_SCHEMA_LINE IN LISTS SETTINGS_SCHEMA_LINES)
  math(EXPR SETTINGS_SCHEMA_LINE_NUMBER "${SETTINGS_SCHEMA_LINE_NUMBER} + 1")
  string(STRIP "${SETTINGS_SCHEMA_LINE}" SETTINGS_SCHEMA_LINE)
  if(SETTINGS_SCHEMA_LINE STREQUAL "" OR SETTINGS_SCHEMA_LINE MATCHES "^#")
    continue()
  endif()
  if(SETTINGS_SCHEMA_LINE MATCHES "^Version=([0-9]+)$")
    if(NOT SETTINGS_SCHEMA_VERSION STREQUAL "")
      message(FATAL_ERROR "Settings schema Version is duplicated")
    endif()
    if(SETTINGS_SCHEMA_SAW_SETTING)
      message(FATAL_ERROR "Settings schema Version must appear before settings")
    endif()
    set(SETTINGS_SCHEMA_VERSION "${CMAKE_MATCH_1}")
    if(NOT SETTINGS_SCHEMA_VERSION STREQUAL "1")
      message(FATAL_ERROR "Unsupported settings schema version: ${SETTINGS_SCHEMA_VERSION}")
    endif()
    continue()
  endif()
  if(SETTINGS_SCHEMA_LINE MATCHES "(^|[ \t])Version=")
    message(FATAL_ERROR "Settings schema Version must be the only property at line ${SETTINGS_SCHEMA_LINE_NUMBER}")
  endif()

  set(SETTINGS_SCHEMA_SAW_SETTING TRUE)
  foreach(SETTINGS_SCHEMA_PROPERTY IN LISTS SETTINGS_SCHEMA_ALLOWED_PROPERTIES)
    unset(SETTING_${SETTINGS_SCHEMA_PROPERTY})
  endforeach()
  string(REGEX REPLACE "[ \t]+" ";" SETTINGS_SCHEMA_TOKENS "${SETTINGS_SCHEMA_LINE}")
  foreach(SETTINGS_SCHEMA_TOKEN IN LISTS SETTINGS_SCHEMA_TOKENS)
    if(NOT SETTINGS_SCHEMA_TOKEN MATCHES "^([A-Za-z][A-Za-z0-9]*)=(.+)$")
      message(FATAL_ERROR "Invalid settings schema token at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_TOKEN}")
    endif()
    set(SETTINGS_SCHEMA_KEY "${CMAKE_MATCH_1}")
    set(SETTINGS_SCHEMA_VALUE "${CMAKE_MATCH_2}")
    list(FIND SETTINGS_SCHEMA_ALLOWED_PROPERTIES "${SETTINGS_SCHEMA_KEY}" SETTINGS_SCHEMA_PROPERTY_INDEX)
    if(SETTINGS_SCHEMA_PROPERTY_INDEX EQUAL -1)
      message(FATAL_ERROR "Unknown settings schema property at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_KEY}")
    endif()
    if(DEFINED SETTING_${SETTINGS_SCHEMA_KEY})
      message(FATAL_ERROR "Duplicate settings schema property at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_KEY}")
    endif()
    set(SETTING_${SETTINGS_SCHEMA_KEY} "${SETTINGS_SCHEMA_VALUE}")
  endforeach()

  foreach(SETTINGS_SCHEMA_REQUIRED_PROPERTY Setting Type Default Scopes Category)
    if(NOT DEFINED SETTING_${SETTINGS_SCHEMA_REQUIRED_PROPERTY} OR "${SETTING_${SETTINGS_SCHEMA_REQUIRED_PROPERTY}}" STREQUAL "")
      message(FATAL_ERROR "Settings schema line ${SETTINGS_SCHEMA_LINE_NUMBER} requires ${SETTINGS_SCHEMA_REQUIRED_PROPERTY}")
    endif()
  endforeach()
  if(NOT SETTING_Setting MATCHES "^[A-Z][A-Za-z0-9]*$")
    message(FATAL_ERROR "Invalid setting name at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}")
  endif()
  list(FIND SETTINGS_SCHEMA_SEEN_SETTINGS "${SETTING_Setting}" SETTINGS_SCHEMA_SETTING_INDEX)
  if(NOT SETTINGS_SCHEMA_SETTING_INDEX EQUAL -1)
    message(FATAL_ERROR "Duplicate setting: ${SETTING_Setting}")
  endif()
  list(APPEND SETTINGS_SCHEMA_SEEN_SETTINGS "${SETTING_Setting}")

  string(REPLACE "," ";" SETTINGS_SCHEMA_SCOPES "${SETTING_Scopes}")
  set(SETTINGS_SCHEMA_SEEN_SCOPES)
  foreach(SETTINGS_SCHEMA_SCOPE IN LISTS SETTINGS_SCHEMA_SCOPES)
    if(SETTINGS_SCHEMA_SCOPE STREQUAL "")
      message(FATAL_ERROR "Settings schema Scopes contains an empty value at line ${SETTINGS_SCHEMA_LINE_NUMBER}")
    endif()
    if(NOT SETTINGS_SCHEMA_SCOPE MATCHES "^[A-Z][A-Za-z0-9]*$")
      message(FATAL_ERROR "Invalid setting scope at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_SCOPE}")
    endif()
    list(FIND SETTINGS_SCHEMA_SEEN_SCOPES "${SETTINGS_SCHEMA_SCOPE}" SETTINGS_SCHEMA_SCOPE_INDEX)
    if(NOT SETTINGS_SCHEMA_SCOPE_INDEX EQUAL -1)
      message(FATAL_ERROR "Settings schema Scopes contains a duplicate value at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_SCOPE}")
    endif()
    list(APPEND SETTINGS_SCHEMA_SEEN_SCOPES "${SETTINGS_SCHEMA_SCOPE}")
  endforeach()

  if(NOT SETTING_Category MATCHES "^[A-Z][A-Za-z0-9]*$")
    message(FATAL_ERROR "Invalid setting category at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Category}")
  endif()

  set(SETTINGS_SCHEMA_MIN_VALUE 0)
  set(SETTINGS_SCHEMA_MAX_VALUE 0)
  set(SETTINGS_SCHEMA_ENUM_VALUES "")
  set(SETTINGS_SCHEMA_UNIT "")
  set(SETTINGS_SCHEMA_GREATER_THAN "")
  if(SETTING_Type STREQUAL "Enum")
    foreach(SETTINGS_SCHEMA_INTEGER_PROPERTY Min Max Unit GreaterThan)
      if(DEFINED SETTING_${SETTINGS_SCHEMA_INTEGER_PROPERTY})
        message(FATAL_ERROR "Enum setting has integer-only property at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}.${SETTINGS_SCHEMA_INTEGER_PROPERTY}")
      endif()
    endforeach()
    if(NOT DEFINED SETTING_Values OR SETTING_Values STREQUAL "")
      message(FATAL_ERROR "Settings schema line ${SETTINGS_SCHEMA_LINE_NUMBER} requires Values")
    endif()
    string(REPLACE "," ";" SETTINGS_SCHEMA_ENUM_LIST "${SETTING_Values}")
    set(SETTINGS_SCHEMA_SEEN_ENUM_VALUES)
    foreach(SETTINGS_SCHEMA_ENUM_VALUE IN LISTS SETTINGS_SCHEMA_ENUM_LIST)
      if(SETTINGS_SCHEMA_ENUM_VALUE STREQUAL "")
        message(FATAL_ERROR "Settings schema Values contains an empty value at line ${SETTINGS_SCHEMA_LINE_NUMBER}")
      endif()
      if(NOT SETTINGS_SCHEMA_ENUM_VALUE MATCHES "^[A-Z][A-Za-z0-9]*$")
        message(FATAL_ERROR "Settings schema Values contains an invalid enum value at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_ENUM_VALUE}")
      endif()
      list(FIND SETTINGS_SCHEMA_SEEN_ENUM_VALUES "${SETTINGS_SCHEMA_ENUM_VALUE}" SETTINGS_SCHEMA_ENUM_INDEX)
      if(NOT SETTINGS_SCHEMA_ENUM_INDEX EQUAL -1)
        message(FATAL_ERROR "Settings schema Values contains a duplicate value at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTINGS_SCHEMA_ENUM_VALUE}")
      endif()
      list(APPEND SETTINGS_SCHEMA_SEEN_ENUM_VALUES "${SETTINGS_SCHEMA_ENUM_VALUE}")
    endforeach()
    list(FIND SETTINGS_SCHEMA_ENUM_LIST "${SETTING_Default}" SETTINGS_SCHEMA_DEFAULT_INDEX)
    if(SETTINGS_SCHEMA_DEFAULT_INDEX EQUAL -1)
      message(FATAL_ERROR "Setting default is not in Values at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}")
    endif()
    set(SETTINGS_SCHEMA_VALUE_TYPE "ValueType::Enum")
    set(SETTINGS_SCHEMA_ENUM_VALUES "${SETTING_Values}")
  elseif(SETTING_Type STREQUAL "Integer")
    if(DEFINED SETTING_Values)
      message(FATAL_ERROR "Integer setting has Values at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}")
    endif()
    foreach(SETTINGS_SCHEMA_INTEGER_PROPERTY Default Min Max)
      if(NOT DEFINED SETTING_${SETTINGS_SCHEMA_INTEGER_PROPERTY} OR NOT SETTING_${SETTINGS_SCHEMA_INTEGER_PROPERTY} MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Setting ${SETTING_Setting}.${SETTINGS_SCHEMA_INTEGER_PROPERTY} must be a non-negative integer at line ${SETTINGS_SCHEMA_LINE_NUMBER}")
      endif()
    endforeach()
    if(SETTING_Min GREATER SETTING_Max OR SETTING_Default LESS SETTING_Min OR SETTING_Default GREATER SETTING_Max)
      message(FATAL_ERROR "Setting integer range is invalid at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}")
    endif()
    if(NOT DEFINED SETTING_Unit OR NOT SETTING_Unit STREQUAL "Milliseconds")
      message(FATAL_ERROR "Integer setting requires Unit=Milliseconds at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Setting}")
    endif()
    set(SETTINGS_SCHEMA_VALUE_TYPE "ValueType::Integer")
    set(SETTINGS_SCHEMA_MIN_VALUE "${SETTING_Min}")
    set(SETTINGS_SCHEMA_MAX_VALUE "${SETTING_Max}")
    set(SETTINGS_SCHEMA_UNIT "${SETTING_Unit}")
    if(DEFINED SETTING_GreaterThan)
      set(SETTINGS_SCHEMA_GREATER_THAN "${SETTING_GreaterThan}")
      list(APPEND SETTINGS_SCHEMA_RELATIONSHIPS "${SETTING_Setting}|${SETTING_GreaterThan}")
    endif()
  else()
    message(FATAL_ERROR "Unsupported setting type at line ${SETTINGS_SCHEMA_LINE_NUMBER}: ${SETTING_Type}")
  endif()

  set(SETTINGS_SCHEMA_DEFAULT_${SETTING_Setting} "${SETTING_Default}")
  set(SETTINGS_SCHEMA_TYPE_${SETTING_Setting} "${SETTING_Type}")
  string(APPEND SETTINGS_SCHEMA_ROWS "    { \"${SETTING_Setting}\", ${SETTINGS_SCHEMA_VALUE_TYPE}, \"${SETTING_Default}\", ${SETTINGS_SCHEMA_MIN_VALUE}, ${SETTINGS_SCHEMA_MAX_VALUE}, \"${SETTINGS_SCHEMA_ENUM_VALUES}\", \"${SETTING_Scopes}\", \"${SETTING_Category}\", \"${SETTINGS_SCHEMA_UNIT}\", \"${SETTINGS_SCHEMA_GREATER_THAN}\" },\n")
endforeach()

if(SETTINGS_SCHEMA_VERSION STREQUAL "")
  message(FATAL_ERROR "Settings schema has no Version")
endif()
list(LENGTH SETTINGS_SCHEMA_SEEN_SETTINGS SETTINGS_SCHEMA_SETTING_COUNT)
if(SETTINGS_SCHEMA_SETTING_COUNT EQUAL 0)
  message(FATAL_ERROR "Settings schema has no settings")
endif()
foreach(SETTINGS_SCHEMA_RELATIONSHIP IN LISTS SETTINGS_SCHEMA_RELATIONSHIPS)
  string(REPLACE "|" ";" SETTINGS_SCHEMA_RELATIONSHIP_PARTS "${SETTINGS_SCHEMA_RELATIONSHIP}")
  list(GET SETTINGS_SCHEMA_RELATIONSHIP_PARTS 0 SETTINGS_SCHEMA_SETTING_NAME)
  list(GET SETTINGS_SCHEMA_RELATIONSHIP_PARTS 1 SETTINGS_SCHEMA_REFERENCED_NAME)
  list(FIND SETTINGS_SCHEMA_SEEN_SETTINGS "${SETTINGS_SCHEMA_REFERENCED_NAME}" SETTINGS_SCHEMA_REFERENCED_INDEX)
  if(SETTINGS_SCHEMA_REFERENCED_INDEX EQUAL -1)
    message(FATAL_ERROR "Setting ${SETTINGS_SCHEMA_SETTING_NAME} references unknown GreaterThan setting: ${SETTINGS_SCHEMA_REFERENCED_NAME}")
  endif()
  if(NOT SETTINGS_SCHEMA_TYPE_${SETTINGS_SCHEMA_SETTING_NAME} STREQUAL "Integer" OR NOT SETTINGS_SCHEMA_TYPE_${SETTINGS_SCHEMA_REFERENCED_NAME} STREQUAL "Integer")
    message(FATAL_ERROR "Setting ${SETTINGS_SCHEMA_SETTING_NAME} has a non-integer GreaterThan relationship")
  endif()
  set(SETTINGS_SCHEMA_SETTING_DEFAULT "${SETTINGS_SCHEMA_DEFAULT_${SETTINGS_SCHEMA_SETTING_NAME}}")
  set(SETTINGS_SCHEMA_REFERENCED_DEFAULT "${SETTINGS_SCHEMA_DEFAULT_${SETTINGS_SCHEMA_REFERENCED_NAME}}")
  if(SETTINGS_SCHEMA_SETTING_DEFAULT LESS_EQUAL SETTINGS_SCHEMA_REFERENCED_DEFAULT)
    message(FATAL_ERROR "Setting ${SETTINGS_SCHEMA_SETTING_NAME} default must be greater than ${SETTINGS_SCHEMA_REFERENCED_NAME}")
  endif()
endforeach()
