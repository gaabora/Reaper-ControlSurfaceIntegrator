export const productIdentity = Object.freeze({
    displayName: "@PRODUCT_DISPLAY_NAME@",
    productId: "@PRODUCT_ID@",
    resourceDirectory: "@PRODUCT_RESOURCE_DIRECTORY@",
    resourceInstallDirectory: "@PRODUCT_RESOURCE_INSTALL_DIRECTORY@",
    configFilename: "@PRODUCT_CONFIG_FILENAME@",
    logFilename: "@PRODUCT_LOG_FILENAME@",
    controlPanelScriptFilename: "@PRODUCT_CONTROL_PANEL_SCRIPT_FILENAME@",
    controlPanelActionId: "@PRODUCT_CONTROL_PANEL_ACTION_ID@",
    notificationsActionId: "@PRODUCT_NOTIFICATIONS_ACTION_ID@",
    notificationsScriptFilename: "@PRODUCT_NOTIFICATIONS_SCRIPT_FILENAME@",
    extStatePrefix: "@PRODUCT_EXTSTATE_PREFIX@",
    reaperRegistrationId: "@PRODUCT_REAPER_REGISTRATION_ID@",
    pluginFilename: "@PRODUCT_PLUGIN_FILENAME@",
    scriptDirectory: "@PRODUCT_SCRIPT_DIRECTORY@",
    packagePrefix: "@PRODUCT_PACKAGE_PREFIX@",
    repositoryUrl: "@PRODUCT_REPOSITORY_URL@",
    extState: Object.freeze({
        osk: "@PRODUCT_EXTSTATE_OSK@",
        oskCommand: "@PRODUCT_EXTSTATE_OSK_COMMAND@",
        oskSettings: "@PRODUCT_EXTSTATE_OSK_SETTINGS@",
        osd: "@PRODUCT_EXTSTATE_OSD@",
        osdSettings: "@PRODUCT_EXTSTATE_OSD_SETTINGS@",
        notifications: "@PRODUCT_EXTSTATE_NOTIFICATIONS@",
        notificationsSettings: "@PRODUCT_EXTSTATE_NOTIFICATIONS_SETTINGS@",
        appearanceSettings: "@PRODUCT_EXTSTATE_APPEARANCE_SETTINGS@",
        controlPanel: "@PRODUCT_EXTSTATE_CONTROL_PANEL@",
        log: "@PRODUCT_EXTSTATE_LOG@",
        logCommand: "@PRODUCT_EXTSTATE_LOG_COMMAND@",
    }),
});

export type ProductIdentity = typeof productIdentity;
