  Decrease+RotaryBig        Reaper "_S&M_METRO_VOL_DOWN"
  Decrease+RotaryBig        Reaper "_S&M_METRO_VOL_DOWN"
  Shift+Decrease+RotaryBig  Reaper "_S&M_METRO_VOL_DOWN" // SWS/S&M: Decrease metronome volume x4
  Shift+Decrease+RotaryBig  Reaper "_S&M_METRO_VOL_DOWN"
  Shift+Decrease+RotaryBig  Reaper "_S&M_METRO_VOL_DOWN"
  Shift+Decrease+RotaryBig  Reaper "_S&M_METRO_VOL_DOWN"

  Increase+RotaryBig        Reaper "_S&M_METRO_VOL_UP" // SWS/S&M: Increase metronome volume x20
  Increase+RotaryBig        Reaper "_S&M_METRO_VOL_UP"
  Increase+RotaryBig        Reaper "_S&M_METRO_VOL_UP"
  Increase+RotaryBig        Reaper "_S&M_METRO_VOL_UP"
