{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "Build plugin using CMake",
      "command": "build",
      "targets": [
        "ALL_BUILD"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": ""
    },
    {
      "type": "cmake",
      "label": "Clean+rebuild plugin using CMake",
      "command": "cleanRebuild",
      "targets": [
        "ALL_BUILD"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": ""
    },
    {
      "label": "Parse this log file",
      "type": "shell",
      "command": "type",
      "args": [
        "${file}"
      ],
      "problemMatcher": {
        "owner": "logfile",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):",
          "file": 1,
          "line": 2
        }
      },
      "presentation": {
        "reveal": "always",
        "echo": true
      }
    },
    {
      "label": "Config Editor: Start",
      "type": "process",
      "group": "build",
      "command": "bun",
      "args": [
        "run",
        "src/start.ts"
      ],
      "options": {
        "cwd": "${workspaceFolder}/tools/config-editor"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Config Editor: Test",
      "type": "process",
      "command": "bun",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/tools/config-editor"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Config Editor: Test watch",
      "type": "process",
      "command": "bun",
      "args": [
        "test",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/tools/config-editor"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Config Editor: Validate path",
      "type": "process",
      "group": "build",
      "command": "bun",
      "args": [
        "run",
        "validate",
        "--",
        "${input:configEditorValidationPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/tools/config-editor"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "configEditorValidationPath",
      "type": "promptString",
      "description": "Config file or directory, relative to tools/config-editor",
      "default": "fixtures/valid"
    }
  ]
}
